{
  "compilerOptions": {
    "outDir": "dist",
    "target": "esnext",
    "module": "commonjs",
    "lib": [
      "es6",
      "DOM",
      "es2023"
    ],
    "typeRoots": ["./global.d.ts"],
    "allowJs": true,
    "jsx": "react-native",
    "declaration": true,
    "noEmit": false,
    "isolatedModules": true,

    "strict": false,
    "noImplicitAny": false,
    "moduleResolution": "node",
    "baseUrl": "./",
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true
  },
  "exclude": [
    "node_modules",
    "babel.config.js",
    "metro.config.js",
    "jest.config.js",
    "Builds",
  ]
}
